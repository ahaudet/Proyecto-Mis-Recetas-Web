                {
                    title: "Cúrcuma", flag: "🇮🇳", category: "Aromático",
                    introduction: "Rizoma subterráneo de la planta Curcuma longa, perteneciente a la familia del jengibre, venerado por su intenso color amarillo dorado y sus propiedades medicinales.",
                    sections: [
                        { title: "Origen y Geografía", content: "Nativa del suroeste de la India, región que actualmente concentra más del ochenta por ciento de la producción mundial y donde se consume desde hace más de cuatro mil años como elemento sagrado en rituales hinduistas, además de su uso culinario. A través de las rutas comerciales de las especias, su cultivo y molienda se extendieron con éxito por todo el sudeste asiático, el norte de África y las islas del Caribe." },
                        { title: "Perfil Sensorial", content: "Posee un aroma cálido, amaderado y con notas sutilmente cítricas que recuerdan al jengibre fresco. En boca ofrece un sabor terroso, ligeramente amargo y almizclado, con una pungencia muy suave. El compuesto químico responsable de su característico color amarillo brillante y de su perfil organoléptico es la curcumina, un potente polifenol antioxidante concentrado en el corazón del rizoma deshidratado." },
                        { title: "Usos comunes", content: "Es el ingrediente indispensable que aporta color y base terrosa al curry en polvo, al Garam Masala y a múltiples platos de arroz, legumbres y mostazas comerciales. También es la base de la 'leche dorada' o Golden Milk. TECNICA GASTRONOMICA: La curcumina es un compuesto liposoluble, lo que significa que libera su máximo potencial de color y sabor cuando se cocina brevemente en una grasa (como aceite o ghee) al inicio de la preparación. Tip de absorción: Se recomienda combinarla siempre con una pizca de pimienta negra, ya que la piperina multiplica de forma exponencial la biodisponibilidad de sus propiedades en el organismo." }
                    ]
                },
                {
                    title: "Locoto", flag: "🇧🇴", category: "Picante",
                    introduction: "Fruto intensamente picante obtenido de la planta Capsicum pubescens, pilar fundamental de la identidad gastronómica y los ajíes de la región andina.",
                    sections: [
                        { title: "Origen y Geografía", content: "Nativo de las regiones montañosas de los Andes, principalmente de Bolivia y Perú, donde se cultiva y consume desde la época preincaica (con registros arqueológicos que datan de miles de años). A diferencia de otras variedades del género Capsicum, es una de las pocas plantas de ají que tolera temperaturas bajas y climas de altura, lo que permitió su arraigo absoluto en la cocina precolombina de montaña." },
                        { title: "Perfil Sensorial", content: "Se diferencia visualmente de manera radical por tener semillas de color negro intenso en su interior y hojas con vellosidades. Su carne es gruesa, jugosa y de paredes anchas, muy similar a la de un morrón pequeño. Despliega un picor potente, punzante y de aparición inmediata en boca, pero que se equilibra con un perfil sorprendentemente frutal, dulce y refrescante, lo que genera una experiencia de pungencia jugosa única en su tipo." },
                        { title: "Usos comunes", content: "Es el alma mater de la llajua boliviana (la salsa picante de mesa por excelencia machacada en batán junto al tomate) y la base del rocoto relleno peruano, además de emplearse fresco en tiraditos, ceviches y guisados andinos. TECNICA GASTRONOMICA: Debido a la textura carnosa de sus paredes, es ideal para consumir en crudo, picado finamente o licuado en salsas frescas. Si se desea reducir de forma drástica su nivel de picor para rellenarlo o usarlo en guisos, se deben retirar por completo las venas y las semillas negras, sometiendo el fruto a tres hervores sucesivos en agua con sal y azúcar, cambiando el líquido en cada proceso." }
                    ]
                }
            ]
        };

        let bookData = BOOK_DATABASE;
        let currentState = 'PORTADA';
        let currentIndex = 0;

        function init() {
            render();
            setupGlobalEvents();
        }

        function render() {
            const left = document.getElementById('left-page');
            const right = document.getElementById('right-page');
            const indicator = document.getElementById('page-indicator');

            if (!left || !right || !indicator) return;

            left.innerHTML = '';
            right.innerHTML = '';

            if (currentState === 'PORTADA') {
                left.innerHTML = `<div class="cover-page">
                    <div class="cover-subtitle">Libro de Cocina</div>
                    <div class="cover-title">Mis Recetas</div>
                    <div class="cover-author">Por Alejandro Haudet</div>
                </div>`;
                right.innerHTML = `<div class="cover-page">
                    <p style="max-width:300px; font-style:italic; color:#8c7662">"Un paseo culinario por los sabores de casa, técnicas tradicionales y el alma de nuestra cocina."</p>
                </div>`;
                indicator.innerText = "PORTADA";
            } 
            
            else if (currentState === 'RECETAS') {
                const r = bookData.recetas[currentIndex];
                const finalImgPath = r.image ? (r.image.includes('/') ? r.image : `fotos-receta/${r.image}`) : '';

                left.innerHTML = `
                    <div class="section-tag">Capítulo I • Recetario</div>
                    <h1>${r.title}</h1>
                    <div class="metadata-line">${r.category}</div>
                    ${finalImgPath ? `<img src="${finalImgPath}" class="item-image" onerror="this.style.display='none';">` : ''}
                    <h2>Ingredientes</h2>
                    <ul>${r.ingredients.map(i => `<li>${i}</li>`).join('')}</ul>
                `;
                
                const pasosArr = r.instructions.split(',');
                const pasosHtml = pasosArr.map(paso => paso.trim() ? `<li>${paso.trim()}</li>` : '').join('');
                
                right.innerHTML = `
                    <div class="metadata-line" style="text-align:right">Preparación</div>
                    <ol>${pasosHtml}</ol>
                    ${r.authorComments ? `<div class="chef-notes">${r.authorComments}</div>` : ''}
                `;
                indicator.innerText = `RECETA ${currentIndex + 1} / ${bookData.recetas.length}`;
            }

            else if (currentState === 'SEPARADOR') {
                left.innerHTML = `<div class="cover-page">
                    <div class="cover-subtitle">Anexo Técnico</div>
                    <div class="cover-title" style="font-size:35pt">Glosario de Especias</div>
                </div>`;
                right.innerHTML = `<div class="cover-page">
                    <p style="max-width:300px; font-style:italic; color:#8c7662">Estudio de los pilares aromáticos y botánicos que definen nuestra identidad gastronómica.</p>
                </div>`;
                indicator.innerText = "SECCIÓN: ESPECIAS";
            }

            else if (currentState === 'GLOSARIO') {
                const e = bookData.glosario[currentIndex];

                left.innerHTML = `
                    <div class="section-tag">Capítulo II • Glosario</div>
                    <h1>${e.title} <span class="flag-emoji">${e.flag}</span></h1>
                    <div class="metadata-line">Perfil: ${e.category}</div>
                    <p><em>${e.introduction}</em></p>
                `;
                let secHtml = e.sections ? e.sections.map(s => `<h2>${s.title}</h2><p>${s.content}</p>`).join('') : '';
                right.innerHTML = `<div class="metadata-line" style="text-align:right">Análisis Técnico</div>${secHtml}`;
                indicator.innerText = `ESPECIA ${currentIndex + 1} / ${bookData.glosario.length}`;
            }

            // Twemoji renderiza las banderas vectoriales HD en cualquier navegador
            twemoji.parse(document.body);
        }

        function goForward() {
            if (currentState === 'PORTADA') { currentState = 'RECETAS'; currentIndex = 0; }
            else if (currentState === 'RECETAS') {
                if (currentIndex < bookData.recetas.length - 1) currentIndex++;
                else { currentState = 'SEPARADOR'; currentIndex = 0; }
            }
            else if (currentState === 'SEPARADOR') { currentState = 'GLOSARIO'; currentIndex = 0; }
            else if (currentState === 'GLOSARIO') {
                if (currentIndex < bookData.glosario.length - 1) currentIndex++;
            }
            render();
        }

        function goBack() {
            if (currentState === 'GLOSARIO') {
                if (currentIndex > 0) currentIndex--;
                else { currentState = 'SEPARADOR'; }
            }
            else if (currentState === 'SEPARADOR') { currentState = 'RECETAS'; currentIndex = bookData.recetas.length - 1; }
            else if (currentState === 'RECETAS') {
                if (currentIndex > 0) currentIndex--;
                else { currentState = 'PORTADA'; }
            }
            render();
        }

        function setupGlobalEvents() {
            document.body.addEventListener('click', function(e) {
                if (e.target && e.target.classList.contains('glossary-link')) {
                    const targetSpice = e.target.getAttribute('data-target');
                    if (targetSpice) {
                        const index = bookData.glosario.findIndex(g => g.title.toLowerCase() === targetSpice.toLowerCase());
