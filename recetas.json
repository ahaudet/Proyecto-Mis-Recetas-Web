<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mis Recetas - Libro Editorial</title>
    <link rel="icon" type="image/png" href="libro.jpg">
    <link rel="apple-touch-icon" href="libro.jpg">
    <meta name="theme-color" content="#FF5733">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <script src="https://cdn.jsdelivr.net/npm/@twemoji/api@14.1.0/dist/twemoji.min.js" crossorigin="anonymous"></script>

    <style>
        body {
            background-color: #dcd6cd;
            font-family: 'Georgia', serif;
            margin: 0; padding: 20px;
            display: flex; flex-direction: column;
            justify-content: center; align-items: center;
            min-height: 100vh;
        }
        .book-container {
            display: flex; width: 100%; max-width: 1200px; min-height: 670px;
            background-color: #fcfbfa; box-shadow: 0 12px 35px rgba(0,0,0,0.3);
            border-radius: 4px; overflow: hidden; position: relative; margin-bottom: 20px;
        }
        .book-container::after {
            content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
            background: linear-gradient(to right, rgba(0,0,0,0.15), rgba(0,0,0,0) 50%, rgba(0,0,0,0.15));
            transform: translateX(-50%); pointer-events: none;
        }
        .page {
            width: 50%; padding: 45px 50px; box-sizing: border-box;
            background-color: #fcfbfa; overflow-y: auto; display: flex; flex-direction: column;
        }
        .page-left { border-right: 1px solid rgba(0,0,0,0.05); }
        .page-right { border-left: 1px solid rgba(0,0,0,0.05); padding-left: 60px; }
        
        img.emoji {
            height: 1.2em;
            width: 1.2em;
            margin: 0 .05em 0 .1em;
            vertical-align: -0.1em;
            display: inline-block;
        }

        .cover-page {
            width: 100%; height: 100%; display: flex; flex-direction: column;
            justify-content: center; align-items: center; text-align: center; margin: auto;
        }
        .cover-title { font-size: 50pt; color: #5c1d1d; margin-bottom: 10px; font-weight: normal; }
        .cover-subtitle { font-size: 18pt; color: #8c7662; text-transform: uppercase; letter-spacing: 4px; }
        .cover-author { margin-top: 50px; font-style: italic; color: #7a6855; }
        .section-tag { font-size: 8.5pt; text-transform: uppercase; letter-spacing: 2px; color: #8c7662; margin-bottom: 10px; font-weight: bold; }
        h1 { font-size: 26pt; color: #5c1d1d; margin: 0 0 5px 0; font-weight: normal; }
        .metadata-line { font-size: 9.5pt; text-transform: uppercase; letter-spacing: 1px; color: #7a6855; border-bottom: 1px solid #e2dacd; padding-bottom: 12px; margin-bottom: 20px; }
        h2 { font-size: 11pt; text-transform: uppercase; color: #5c1d1d; border-bottom: 1px dashed #e2dacd; padding-bottom: 4px; margin-top: 20px; }
        .item-image {
            width: 100%; max-height: 230px; object-fit: cover; border-radius: 4px;
            margin: 15px 0; border: 1px solid #e2dacd; box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }
        p, li { color: #2c2520; line-height: 1.6; font-size: 11pt; text-align: justify; }
        ul, ol { padding-left: 20px; margin-top: 5px; }
        li { margin-bottom: 6px; }
        .chef-notes { background-color: #f5efe6; border-left: 3px solid #8c7662; padding: 15px; margin-top: auto; font-style: italic; }
        .nav-controls { display: flex; gap: 15px; background: white; padding: 10px 25px; border-radius: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); align-items: center; }
        .nav-btn { background: none; border: 1px solid #8c7662; color: #8c7662; padding: 6px 18px; border-radius: 20px; cursor: pointer; font-family: Arial, sans-serif; }
        .nav-btn:hover { background-color: #8c7662; color: white; }
        .glossary-link { color: #5c1d1d; text-decoration: none; border-bottom: 1px dashed #5c1d1d; cursor: pointer; font-weight: bold; }
        .glossary-link:hover { background-color: #f5efe6; border-bottom: 1px solid #5c1d1d; }
        @media (max-width: 850px) {
            .book-container { flex-direction: column; min-height: auto; }
            .book-container::after { display: none; }
            .page { width: 100%; padding: 30px 25px; }
            .page-left { border-right: none; border-bottom: 1px dashed #e2dacd; }
            .page-right { padding-left: 25px; border-left: none; }
        }
    </style>
</head>
<body>

    <div class="book-container" id="book">
        <div class="page page-left" id="left-page"></div>
        <div class="page page-right" id="right-page"></div>
    </div>

    <div class="nav-controls">
        <button class="nav-btn" onclick="goBack()">← Anterior</button>
        <span id="page-indicator" style="font-weight: bold; color: #666; font-family: Arial, sans-serif;">Cargando...</span>
        <button class="nav-btn" onclick="goForward()">Siguiente →</button>
    </div>

